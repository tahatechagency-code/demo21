# Copy to .env and fill in for local development.
# Never commit a real .env file.

NODE_ENV=development
LOG_LEVEL=info

# API
# Most PaaS providers (Render, Heroku, ...) assign this via their own PORT
# variable instead — apps/api/src/env.ts adopts PORT automatically when
# API_PORT itself isn't set, so you don't need to set this in production.
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Max JSON body size accepted by the API, in bytes
API_BODY_LIMIT_BYTES=102400
# Requests allowed per IP per RATE_LIMIT_WINDOW_MS
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Web
WEB_PORT=3000
# Server-side only: base URL the Next.js server uses to reach the API.
# Never exposed to the browser (no NEXT_PUBLIC_ prefix).
INTERNAL_API_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_concierge

# Redis
REDIS_URL=redis://localhost:6379

# Outbound network allowlist (SSRF protection), comma-separated hostnames
OUTBOUND_ALLOWED_HOSTS=localhost,127.0.0.1

# Webhook signature secret (HMAC), placeholder only — replace per channel in later phases
WEBHOOK_SIGNING_SECRET=change-me-in-production

# OpenTelemetry — leave unset to disable exporting (Phase 1 default: NOT_CONFIGURED)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-concierge

# Multi-tenancy — default tenant used until Phase 2 tenant management ships
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# First Admin Dashboard account (packages/db/src/bootstrapAdmin.ts, run via
# `pnpm --filter @ai-concierge/db run bootstrap-admin`, or automatically on
# every production start — see scripts/start-production.mjs). Idempotent:
# skips once this account exists, and a no-op if either is left unset.
# There's no self-serve signup route by design — staff accounts are
# provisioned this way, then created ones can be locked/unlocked via
# POST /v1/users/:userId/lock (Permission.USER_LOCK).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# WhatsApp (Meta Cloud API) — leave all unset to keep the channel
# NOT_CONFIGURED (webhook rejects inbound, no outbound sends are attempted).
# 1. Create a Meta App -> add the WhatsApp product -> API Setup page.
# 2. WHATSAPP_PHONE_NUMBER_ID: the "Phone number ID" shown there (not the
#    phone number itself).
# 3. WHATSAPP_ACCESS_TOKEN: a token for that number (use a permanent System
#    User token for anything beyond a quick test — the default one expires
#    in 24h).
# 4. WHATSAPP_APP_SECRET: App Dashboard -> Settings -> Basic -> App Secret.
#    Used to verify the X-Hub-Signature-256 header on every inbound webhook.
# 5. WHATSAPP_VERIFY_TOKEN: any string you choose yourself. When you
#    register the webhook URL (https://<your-api-host>/webhooks/whatsapp) in
#    Meta's dashboard, paste this same value into its "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Phase 6 — Availability. FLEET_PROVIDER=database (default) needs no other
# configuration: it counts real VehicleUnit rows in our own database, which
# is always the source of truth. Set FLEET_PROVIDER=external only if a
# third-party fleet-management API should supply unit counts instead; left
# unconfigured, it reports NOT_CONFIGURED rather than a fake integration.
FLEET_PROVIDER=database
FLEET_API_BASE_URL=
FLEET_API_KEY=
FLEET_API_TIMEOUT_MS=3000
# How long a temporary hold survives before it lapses back to available capacity.
AVAILABILITY_HOLD_TTL_SECONDS=900
# Quiet-chat check-ins (3 min, 30 min, 1 week after the AI's last message); 0 = off
FOLLOW_UP_SWEEP_INTERVAL_MS=30000
# Turnaround buffer (minutes) applied to both ends of an overlap check (cleaning/inspection window).
AVAILABILITY_TURNAROUND_BUFFER_MINUTES=120
# How often the worker's housekeeping sweep flips lapsed holds to EXPIRED (never load-bearing for correctness).
HOLD_EXPIRATION_SWEEP_INTERVAL_MS=60000

# Phase 6 — AuthN/AuthZ. Both required; unlike the provider seams above there
# is no NOT_CONFIGURED state for staff login. The values below are randomly
# generated for local dev only — regenerate real ones before any non-local
# deployment (never reuse these, they are public in version control):
#   JWT_SIGNING_SECRET: any random string >= 32 characters
#   MFA_ENCRYPTION_KEY: base64 for exactly 32 bytes, e.g.
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SIGNING_SECRET=change-me-in-production-min-32-characters-long-value
MFA_ENCRYPTION_KEY=zsqFPLXxhE2jMyWnSscCoupYiPB3Mi1V7cuiAh0FR4I=
AUTH_TOKEN_ISSUER=AI Concierge
# Brute-force protection scoped to /v1/auth/login and /v1/auth/refresh,
# stricter than the app-wide RATE_LIMIT_MAX/_WINDOW_MS above.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Least-privilege DB roles (packages/db/prisma/migrations/..._add_security_engine).
# See docs/SECURITY-MODEL.md for why local dev/CI still default DATABASE_URL
# to the superuser connection instead of these — production should not.
# DIRECT_DATABASE_URL (superuser) is for `prisma migrate deploy` only, once
# DATABASE_URL itself is switched to a scoped role.
# DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_concierge

# Gemini — conversational reply generation only. Steps 1-4's business facts
# (dates, vehicle, availability, pricing) always come from the deterministic
# pipeline, never from this model; leave GEMINI_API_KEY unset to keep the
# adapter NOT_CONFIGURED (replies fall back to the existing deterministic
# templates, nothing breaks). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# No plain "gemini-3.1-flash" GA model id exists as of this writing (only
# gemini-3.1-flash-lite does, at that version) — see docs/phases/PHASE-06.md
# §2 for what was actually verified against Google's docs. Confirm against
# your own account's model access and override here; nothing else changes.
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_TEMPERATURE=0.6
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TIMEOUT_MS=8000

# Twilio — staff SMS paging only (EscalationCase alerts to the worker a case
# is assigned to), never a customer-facing channel. All optional; leave
# unset to keep NOT_CONFIGURED (an escalation still creates the case and is
# visible on the dashboard, just no SMS ping). Get these from
# https://console.twilio.com — Account SID + Auth Token on the dashboard
# home, TWILIO_FROM_NUMBER is a phone number you've purchased/verified there.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Mailgun — the Email channel (customer-facing, mirrors WhatsApp: real
# inbound webhook with signature verification + real outbound send). All
# optional; leave unset to keep NOT_CONFIGURED.
# 1. Create a Mailgun account -> add/verify a sending domain.
# 2. MAILGUN_DOMAIN: that sending domain (e.g. mail.yourbusiness.com).
# 3. MAILGUN_API_KEY: Settings -> API Keys -> Private API key.
# 4. MAILGUN_FROM_ADDRESS: the address replies are sent from, at your domain.
# 5. MAILGUN_WEBHOOK_SIGNING_KEY: Sending -> Webhooks -> HTTP webhook signing
#    key. Used to verify the timestamp/token/signature Mailgun sends with
#    every inbound-routing webhook call.
# 6. Register https://<your-api-host>/webhooks/email as an inbound route's
#    action in Mailgun's Receiving > Routes, with the route's content type
#    set to application/x-www-form-urlencoded (no file attachments) — see
#    apps/api/src/routes/webhooks/email.ts for why.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_ADDRESS=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Gemini conversational engine — leave GEMINI_API_KEY unset to keep replies on the
# deterministic drafts (NOT_CONFIGURED). There is no plain "gemini-3.1-flash":
# use gemini-3.8-flash (default) or gemini-3.1-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# Optional dedicated AES-256 key (base64, 32 bytes) for customer PII at rest (date of
# birth collected for eligibility). Unset = derived from MFA_ENCRYPTION_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

# Concierge Engine (see packages/ai/src/concierge/profile.ts)
# Brand used in every reply (default Diamondlease).
BUSINESS_NAME=Diamondlease
# Optional JSON overrides: popularModels, publicHolidays ["2026-12-02"], confirmBranches ["habtoor-grand"], extraBranches, minDriverAge.
# BUSINESS_PROFILE_JSON={"publicHolidays":["2027-03-10"]}
# Facts the concierge may state: {"INSURANCE":"...","MILEAGE":"...","HOURS":"...","PAYMENT_METHODS":"..."}. Unset topics are never invented; the bot offers the team.
# BUSINESS_FACTS_JSON=
# Google Maps key: measures real road distance for delivery to places the built-in UAE list does not know.
# GOOGLE_MAPS_API_KEY=
