{
  "name": "@ai-concierge/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/seed.js",
    "bootstrap-admin": "node dist/bootstrapAdmin.js",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc",
    "test:unit": "echo \"no pure-unit tests in @ai-concierge/db (see test:integration)\"",
    "test:integration": "vitest run --exclude \"**/*.security.test.ts\"",
    "test:security": "vitest run .security.test."
  },
  "dependencies": {
    "@ai-concierge/domain": "workspace:*",
    "@ai-concierge/security": "workspace:*",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@ai-concierge/testing": "workspace:*",
    "prisma": "^6.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
