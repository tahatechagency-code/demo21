{
  "name": "@ai-concierge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.security.test.ts\"",
    "test:integration": "vitest run integration.test.",
    "test:security": "vitest run .security.test."
  },
  "dependencies": {
    "@ai-concierge/ai": "workspace:*",
    "@ai-concierge/channels": "workspace:*",
    "@ai-concierge/config": "workspace:*",
    "@ai-concierge/contracts": "workspace:*",
    "@ai-concierge/db": "workspace:*",
    "@ai-concierge/domain": "workspace:*",
    "@ai-concierge/observability": "workspace:*",
    "@ai-concierge/security": "workspace:*",
    "@ai-concierge/workflow": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.0.0",
    "bullmq": "^5.34.6",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ai-concierge/testing": "workspace:*",
    "@types/node": "^22.9.0",
    "pino": "^9.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
